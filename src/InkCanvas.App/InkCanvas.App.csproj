<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>InkCanvas.App</RootNamespace>
    <AssemblyName>InkCanvas</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWinUI>true</UseWinUI>
    <!--
      Unpackaged deployment: no MSIX, no AppxPackage MSBuild targets, no VS UWP workload.
      Self-contained Windows App SDK so the machine needs no separate runtime install.
    -->
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>
    <ApplicationIcon>Assets\InkCanvas.ico</ApplicationIcon>
    <Version>3.10.0</Version>
    <Product>Ink Canvas (WinUI 3)</Product>
    <IncludeScreenTrackingModule Condition="'$(IncludeScreenTrackingModule)' == ''">true</IncludeScreenTrackingModule>
    <IncludeAiAssistantModule Condition="'$(IncludeAiAssistantModule)' == ''">true</IncludeAiAssistantModule>
    <IncludeLibraryModule Condition="'$(IncludeLibraryModule)' == ''">true</IncludeLibraryModule>
    <IncludePdfModule Condition="'$(IncludePdfModule)' == ''">true</IncludePdfModule>
    <IncludeAnalyticGeometryModule Condition="'$(IncludeAnalyticGeometryModule)' == ''">true</IncludeAnalyticGeometryModule>
    <IncludeTimeMachineModule Condition="'$(IncludeTimeMachineModule)' == ''">true</IncludeTimeMachineModule>
    <IncludeCloudSyncModule Condition="'$(IncludeCloudSyncModule)' == ''">true</IncludeCloudSyncModule>
    <IncludeMcpModule Condition="'$(IncludeMcpModule)' == ''">true</IncludeMcpModule>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\InkCanvas.UpdateHost\InkCanvas.UpdateHost.csproj" ReferenceOutputAssembly="false" Private="false" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="$(Win2DVersion)" />
    <PackageReference Include="PhotoSauce.NativeCodecs.Libwebp" Version="1.6.0-preview1" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="1.8.260803003" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="$(WindowsAppSdkVersion)" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="1.8.260803002" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="1.8.260708001" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="1.8.25122902" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\InkCanvas.Core\InkCanvas.Core.csproj" />
    <ProjectReference Include="..\InkCanvas.Platform\InkCanvas.Platform.csproj" />
    <ProjectReference Include="..\InkCanvas.Ink\InkCanvas.Ink.csproj" />
    <ProjectReference Include="..\InkCanvas.Controls\InkCanvas.Controls.csproj" />
    <ProjectReference Include="..\InkCanvas.Features\InkCanvas.Features.csproj" />
    <ProjectReference Include="..\InkCanvas.Extensions\InkCanvas.Extensions.csproj" />
    <ProjectReference Include="..\InkCanvas.Host.Contracts\InkCanvas.Host.Contracts.csproj" />
    <ProjectReference Include="..\InkCanvas.Modules.ScreenTracking\InkCanvas.Modules.ScreenTracking.csproj" ReferenceOutputAssembly="false" Private="false" Condition="'$(IncludeScreenTrackingModule)' == 'true'" />
    <ProjectReference Include="..\InkCanvas.Modules.Pdf\InkCanvas.Modules.Pdf.csproj" ReferenceOutputAssembly="false" Private="false" Condition="'$(IncludePdfModule)' == 'true'" />
    <ProjectReference Include="..\InkCanvas.Modules.AnalyticGeometry\InkCanvas.Modules.AnalyticGeometry.csproj" ReferenceOutputAssembly="false" Private="false" Condition="'$(IncludeAnalyticGeometryModule)' == 'true'" />
    <ProjectReference Include="..\InkCanvas.Modules.AiAssistant\InkCanvas.Modules.AiAssistant.csproj" ReferenceOutputAssembly="false" Private="false" Condition="'$(IncludeAiAssistantModule)' == 'true'" />
    <ProjectReference Include="..\InkCanvas.Modules.Library\InkCanvas.Modules.Library.csproj" ReferenceOutputAssembly="false" Private="false" Condition="'$(IncludeLibraryModule)' == 'true'" />
    <ProjectReference Include="..\InkCanvas.Modules.TimeMachine\InkCanvas.Modules.TimeMachine.csproj" ReferenceOutputAssembly="false" Private="false" Condition="'$(IncludeTimeMachineModule)' == 'true'" />
    <ProjectReference Include="..\InkCanvas.Modules.CloudSync\InkCanvas.Modules.CloudSync.csproj" ReferenceOutputAssembly="false" Private="false" Condition="'$(IncludeCloudSyncModule)' == 'true'" />
    <ProjectReference Include="..\InkCanvas.PluginHost\InkCanvas.PluginHost.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\InkCanvas.Modules.Mcp\InkCanvas.Modules.Mcp.csproj" ReferenceOutputAssembly="false" Private="false" Condition="'$(IncludeMcpModule)' == 'true'" />
    <ProjectReference Include="..\InkCanvas.McpHost\InkCanvas.McpHost.csproj" ReferenceOutputAssembly="false" Private="false" Condition="'$(IncludeMcpModule)' == 'true'" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\**\*.*" Exclude="Assets\FluentSystemIcons*.ttf;Assets\SegoeMDL2Assets.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="Assets\Board\*.png" CopyToPublishDirectory="PreserveNewest" />
    <!-- MIT 开源图标字体（microsoft/fluentui-system-icons）：随构建与发布输出，跨 Win10/11 一致渲染。 -->
    <Content Include="Assets\FluentSystemIcons.ttf;Assets\FluentSystemIcons-Regular.ttf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\CHANGELOG.md" Link="CHANGELOG.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    dotnet publish does not copy the app's own generated resource index (<AssemblyName>.pri)
    for an unpackaged WinUI 3 app. Without it, cross-assembly resource lookups such as
    ms-appx:///InkCanvas.Controls/Themes/Tokens.xaml fail at runtime with
    "Cannot find a resource with the given key", and the shell throws on first window.
    Copy it explicitly so the published folder actually runs.
  -->
  <!--
    Unpackaged publish does not copy loose XBF / cross-assembly XAML resource folders either.
    Without App.xbf the App.InitializeComponent throws XamlParseException at startup; without
    InkCanvas.Controls/Themes the token dictionary lookup fails on the first window.
  -->
  <Target Name="CopyXamlResourcesToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_LooseXbf Include="$(OutDir)App.xbf" />
      <_CtrlXamlRes Include="$(OutDir)InkCanvas.Controls\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_LooseXbf)" DestinationFolder="$(PublishDir)" Condition="Exists('$(OutDir)App.xbf')" />
    <Copy SourceFiles="@(_CtrlXamlRes)" DestinationFolder="$(PublishDir)InkCanvas.Controls\%(RecursiveDir)" />
  </Target>
  <Target Name="CopyAppPriToPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(OutDir)$(TargetName).pri"
          DestinationFolder="$(PublishDir)"
          Condition="Exists('$(OutDir)$(TargetName).pri')" />
    <Warning Text="App resource index $(TargetName).pri was not found; the published app may fail to resolve theme resources."
             Condition="!Exists('$(OutDir)$(TargetName).pri')" />
  </Target>
  <Target Name="CopyExtensionPackages" AfterTargets="Build;Publish">
    <ItemGroup Condition="'$(IncludeMcpModule)' == 'true'">
      <_McpOutputFiles Include="..\InkCanvas.Modules.Mcp\bin\$(Platform)\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\InkCanvas.Modules.Mcp.dll;..\InkCanvas.Modules.Mcp\bin\$(Platform)\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\InkCanvas.Modules.Mcp.deps.json;..\InkCanvas.Modules.Mcp\bin\$(Platform)\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\ModelContextProtocol.Core.dll;..\InkCanvas.Modules.Mcp\bin\$(Platform)\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\Microsoft.Extensions.AI.Abstractions.dll;..\InkCanvas.Modules.Mcp\bin\$(Platform)\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\Microsoft.Extensions.Logging.Abstractions.dll;..\InkCanvas.Modules.Mcp\module.json" />
      <_McpOutputFiles Include="..\InkCanvas.Modules.Mcp\bin\$(Platform)\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\Microsoft.Extensions.DependencyInjection.Abstractions.dll" />
      <_McpOutputFiles Include="..\InkCanvas.McpHost\bin\$(Platform)\$(Configuration)\net10.0\$(RuntimeIdentifier)\InkCanvas.McpHost.*" Exclude="..\InkCanvas.McpHost\bin\$(Platform)\$(Configuration)\net10.0\$(RuntimeIdentifier)\*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(_McpOutputFiles)" DestinationFolder="$(OutDir)Modules\inkcanvas.mcp\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_McpOutputFiles)" DestinationFolder="$(PublishDir)Modules\inkcanvas.mcp\" SkipUnchangedFiles="true" Condition="'$(PublishDir)' != ''" />
    <ItemGroup Condition="'$(IncludeCloudSyncModule)' == 'true'">
      <_CloudSyncFiles Include="..\InkCanvas.Modules.CloudSync\bin\$(Platform)\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\InkCanvas.Modules.CloudSync.dll;..\InkCanvas.Modules.CloudSync\bin\$(Platform)\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\InkCanvas.Modules.CloudSync.deps.json;..\InkCanvas.Modules.CloudSync\module.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_CloudSyncFiles)" DestinationFolder="$(OutDir)Modules\inkcanvas.cloud-sync\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_CloudSyncFiles)" DestinationFolder="$(PublishDir)Modules\inkcanvas.cloud-sync\" SkipUnchangedFiles="true" Condition="'$(PublishDir)' != ''" />
    <PropertyGroup>
      <_ExtensionOutput>$(MSBuildProjectDirectory)\..\InkCanvas.Modules.ScreenTracking\bin\$(Platform)\$(Configuration)\net10.0-windows10.0.26100.0\$(RuntimeIdentifier)\</_ExtensionOutput>
      <_WorkerOutput>$(MSBuildProjectDirectory)\..\InkCanvas.PluginHost\bin\$(Platform)\$(Configuration)\net10.0\$(RuntimeIdentifier)\</_WorkerOutput>
      <_UpdaterOutput>$(MSBuildProjectDirectory)\..\InkCanvas.UpdateHost\bin\$(Platform)\$(Configuration)\net10.0\$(RuntimeIdentifier)\</_UpdaterOutput>
      <_PdfOutput>$(MSBuildProjectDirectory)\..\InkCanvas.Modules.Pdf\bin\$(Platform)\$(Configuration)\net10.0-windows10.0.26100.0\$(RuntimeIdentifier)\</_PdfOutput>
      <_AssistantOutput>$(MSBuildProjectDirectory)\..\InkCanvas.Modules.AiAssistant\bin\$(Platform)\$(Configuration)\net10.0-windows10.0.26100.0\$(RuntimeIdentifier)\</_AssistantOutput>
      <_LibraryOutput>$(MSBuildProjectDirectory)\..\InkCanvas.Modules.Library\bin\$(Platform)\$(Configuration)\net10.0-windows10.0.26100.0\$(RuntimeIdentifier)\</_LibraryOutput>
      <_GeometryOutput>$(MSBuildProjectDirectory)\..\InkCanvas.Modules.AnalyticGeometry\bin\$(Platform)\$(Configuration)\net10.0-windows10.0.26100.0\$(RuntimeIdentifier)\</_GeometryOutput>
      <_TimeMachineOutput>$(MSBuildProjectDirectory)\..\InkCanvas.Modules.TimeMachine\bin\$(Platform)\$(Configuration)\net10.0-windows10.0.26100.0\$(RuntimeIdentifier)\</_TimeMachineOutput>
    </PropertyGroup>
    <ItemGroup>
      <_AssistantFiles Include="$(_AssistantOutput)InkCanvas.Modules.AiAssistant.dll;$(_AssistantOutput)InkCanvas.Modules.AiAssistant.deps.json;$(_AssistantOutput)module.json" Condition="'$(IncludeAiAssistantModule)' == 'true'" />
      <_AssistantLicenses Include="$(_AssistantOutput)Licenses\ProviderIcons.txt;$(_AssistantOutput)Licenses\OpenCode.txt" Condition="'$(IncludeAiAssistantModule)' == 'true'" />
      <_LibraryFiles Include="$(_LibraryOutput)InkCanvas.Modules.Library.dll;$(_LibraryOutput)InkCanvas.Modules.Library.deps.json;$(_LibraryOutput)module.json" Condition="'$(IncludeLibraryModule)' == 'true'" />
      <_ModuleFiles Include="$(_ExtensionOutput)InkCanvas.Modules.ScreenTracking.dll;$(_ExtensionOutput)InkCanvas.Modules.ScreenTracking.deps.json;$(_ExtensionOutput)Interop.UIAutomationClient.dll;$(_ExtensionOutput)module.json;$(_ExtensionOutput)UIAutomation-Interop.txt" Condition="'$(IncludeScreenTrackingModule)' == 'true'" />
      <_WorkerFiles Include="$(_WorkerOutput)*.dll;$(_WorkerOutput)*.exe;$(_WorkerOutput)*.json" />
      <_UpdaterFiles Include="$(_UpdaterOutput)*.dll;$(_UpdaterOutput)*.exe;$(_UpdaterOutput)*.json" />
      <_PdfFiles Include="$(_PdfOutput)InkCanvas.Modules.Pdf.dll;$(_PdfOutput)InkCanvas.Modules.Pdf.deps.json;$(_PdfOutput)InkCanvas.Pdf.dll;$(_PdfOutput)PdfSharp*.dll;$(_PdfOutput)UglyToad.PdfPig*.dll;$(_PdfOutput)Microsoft.Extensions.*.dll;$(_PdfOutput)System.Security.Cryptography.Pkcs.dll;$(_PdfOutput)module.json" Condition="'$(IncludePdfModule)' == 'true'" />
      <_PdfLicenses Include="$(_PdfOutput)Licenses\*.txt" Condition="'$(IncludePdfModule)' == 'true'" />
      <_PdfFiles Include="$(_PdfOutput)Clipper2Lib.dll" Condition="'$(IncludePdfModule)' == 'true'" />
      <_GeometryFiles Include="$(_GeometryOutput)InkCanvas.Modules.AnalyticGeometry.dll;$(_GeometryOutput)InkCanvas.Modules.AnalyticGeometry.deps.json;$(_GeometryOutput)InkCanvas.AnalyticGeometry.dll;$(_GeometryOutput)module.json" Condition="'$(IncludeAnalyticGeometryModule)' == 'true'" />
      <_GeometryFiles Include="$(_GeometryOutput)AngouriMath.dll;$(_GeometryOutput)Antlr4.Runtime.Standard.dll;$(_GeometryOutput)GenericTensor.dll;$(_GeometryOutput)HonkSharp.dll;$(_GeometryOutput)Numbers.dll;$(_GeometryOutput)PdfSharp.dll;$(_GeometryOutput)PdfSharp.Shared.dll;$(_GeometryOutput)PdfSharp.System.dll;$(_GeometryOutput)PdfSharp.Cryptography.dll;$(_GeometryOutput)Microsoft.Extensions.Logging.Abstractions.dll;$(_GeometryOutput)Microsoft.Extensions.DependencyInjection.Abstractions.dll;$(_GeometryOutput)System.Security.Cryptography.Pkcs.dll" Condition="'$(IncludeAnalyticGeometryModule)' == 'true'" />
      <_GeometryLicenses Include="$(_GeometryOutput)Licenses\*.txt" Condition="'$(IncludeAnalyticGeometryModule)' == 'true'" />
      <_GeometryFiles Include="$(_GeometryOutput)Jint.dll;$(_GeometryOutput)Acornima.dll" Condition="'$(IncludeAnalyticGeometryModule)' == 'true'" />
      <_TimeMachineFiles Include="$(_TimeMachineOutput)InkCanvas.Modules.TimeMachine.dll;$(_TimeMachineOutput)InkCanvas.Modules.TimeMachine.deps.json;$(_TimeMachineOutput)module.json" Condition="'$(IncludeTimeMachineModule)' == 'true'" />
    </ItemGroup>
    <Copy SourceFiles="@(_AssistantFiles)" DestinationFolder="$(OutDir)Modules\inkcanvas.ai-assistant\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_AssistantLicenses)" DestinationFolder="$(OutDir)Modules\inkcanvas.ai-assistant\Licenses\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_LibraryFiles)" DestinationFolder="$(OutDir)Modules\inkcanvas.library\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_LibraryFiles)" DestinationFolder="$(PublishDir)Modules\inkcanvas.library\" SkipUnchangedFiles="true" Condition="'$(PublishDir)' != ''" />
    <Copy SourceFiles="@(_AssistantFiles)" DestinationFolder="$(PublishDir)Modules\inkcanvas.ai-assistant\" SkipUnchangedFiles="true" Condition="'$(PublishDir)' != ''" />
    <Copy SourceFiles="@(_AssistantLicenses)" DestinationFolder="$(PublishDir)Modules\inkcanvas.ai-assistant\Licenses\" SkipUnchangedFiles="true" Condition="'$(PublishDir)' != ''" />
    <Copy SourceFiles="@(_ModuleFiles)" DestinationFolder="$(OutDir)Modules\inkcanvas.screen-tracking\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_WorkerFiles)" DestinationFolder="$(OutDir)PluginHost\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_UpdaterFiles)" DestinationFolder="$(OutDir)UpdateHost\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_PdfFiles)" DestinationFolder="$(OutDir)Modules\inkcanvas.pdf\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_PdfLicenses)" DestinationFolder="$(OutDir)Modules\inkcanvas.pdf\Licenses\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_GeometryFiles)" DestinationFolder="$(OutDir)Modules\inkcanvas.analytic-geometry\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_GeometryLicenses)" DestinationFolder="$(OutDir)Modules\inkcanvas.analytic-geometry\Licenses\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_ModuleFiles)" DestinationFolder="$(PublishDir)Modules\inkcanvas.screen-tracking\" SkipUnchangedFiles="true" Condition="'$(PublishDir)' != ''" />
    <Copy SourceFiles="@(_WorkerFiles)" DestinationFolder="$(PublishDir)PluginHost\" SkipUnchangedFiles="true" Condition="'$(PublishDir)' != ''" />
    <Copy SourceFiles="@(_UpdaterFiles)" DestinationFolder="$(PublishDir)UpdateHost\" SkipUnchangedFiles="true" Condition="'$(PublishDir)' != ''" />
    <Copy SourceFiles="@(_PdfFiles)" DestinationFolder="$(PublishDir)Modules\inkcanvas.pdf\" SkipUnchangedFiles="true" Condition="'$(PublishDir)' != ''" />
    <Copy SourceFiles="@(_PdfLicenses)" DestinationFolder="$(PublishDir)Modules\inkcanvas.pdf\Licenses\" SkipUnchangedFiles="true" Condition="'$(PublishDir)' != ''" />
    <Copy SourceFiles="@(_GeometryFiles)" DestinationFolder="$(PublishDir)Modules\inkcanvas.analytic-geometry\" SkipUnchangedFiles="true" Condition="'$(PublishDir)' != ''" />
    <Copy SourceFiles="@(_GeometryLicenses)" DestinationFolder="$(PublishDir)Modules\inkcanvas.analytic-geometry\Licenses\" SkipUnchangedFiles="true" Condition="'$(PublishDir)' != ''" />
    <Copy SourceFiles="@(_TimeMachineFiles)" DestinationFolder="$(OutDir)Modules\inkcanvas.time-machine\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_TimeMachineFiles)" DestinationFolder="$(PublishDir)Modules\inkcanvas.time-machine\" SkipUnchangedFiles="true" Condition="'$(PublishDir)' != ''" />
  </Target>
  <!--
    The self-contained Windows App SDK runtime payload ships components this app never uses:
    Windows AI / ML (onnxruntime + DirectML alone are ~38 MB), Widgets and Semantic Search.
    Strip them, keep only the languages we ship, and drop symbols. Verified by launching the
    published app after cleanup.
  -->
  <PropertyGroup>
    <InkCanvasKeepLanguages>en-US;zh-CN;zh-Hans;zh-TW</InkCanvasKeepLanguages>
  </PropertyGroup>

  <Target Name="TrimPublishedPayload" AfterTargets="CopyAppPriToPublish">
    <ItemGroup>
      <_UnusedPayload Include="$(PublishDir)onnxruntime*.dll" />
      <_UnusedPayload Include="$(PublishDir)DirectML.dll" />
      <_UnusedPayload Include="$(PublishDir)Microsoft.Windows.AI.*" />
      <_UnusedPayload Include="$(PublishDir)Microsoft.WindowsAppSDK.ML.*" />
      <_UnusedPayload Include="$(PublishDir)Microsoft.WindowsAppSDK.AI.*" />
      <_UnusedPayload Include="$(PublishDir)Microsoft.Windows.Widgets.*" />
      <_UnusedPayload Include="$(PublishDir)Microsoft.WindowsAppSDK.Widgets.*" />
      <_UnusedPayload Include="$(PublishDir)Microsoft.Windows.SemanticSearch.*" />
      <_UnusedPayload Include="$(PublishDir)**\*.pdb" />
      <_UnusedPayload Include="$(PublishDir)**\*.xml" />
    </ItemGroup>
    <Delete Files="@(_UnusedPayload)" ContinueOnError="true" />

    <!-- Language satellites: .mui files live in per-language subfolders. -->
    <ItemGroup>
      <_LangDirs Include="$([System.IO.Directory]::GetDirectories('$(PublishDir)'))" />
      <_StaleLangFiles Include="%(_LangDirs.Identity)\**\*.mui"
                       Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('%(_LangDirs.Filename)', '^(en-US|zh-CN|zh-Hans|zh-TW)$'))" />
    </ItemGroup>
    <Delete Files="@(_StaleLangFiles)" ContinueOnError="true" />

    <Message Importance="high" Text="Trimmed unused Windows App SDK payload (AI/ML/Widgets) and extra languages from $(PublishDir)" />
  </Target>
</Project>
