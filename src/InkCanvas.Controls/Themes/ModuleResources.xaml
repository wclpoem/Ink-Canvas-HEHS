<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:InkCanvas.Controls.Controls">

    <!--
    模块与插件窗口的共享设计资源，所有尺寸均为 DIP。
    在 App.xaml 的 MergedDictionaries 中先加载 XamlControlsResources，再合并本文件。
    Source="ms-appx:///InkCanvas.Controls/Themes/ModuleResources.xaml"
    也可将本 ResourceDictionary 的内容直接并入 Application.Resources。

    Mica / Acrylic 在 Window.SystemBackdrop 或 WindowFrame 上配置。
    窗口根层使用透明背景，实体窗口回退层使用 IcModuleWindowBackgroundBrush。
    色彩通过 ThemeResource 引用，随各窗口 RequestedTheme 与系统主题色更新。

    常用示例
    Border Style="{StaticResource IcModuleCardStyle}"
    Button Style="{StaticResource IcModulePrimaryButtonStyle}"
    controls:TouchIconButton Style="{StaticResource IcModuleIconButtonStyle}"
    FontIcon Style="{StaticResource IcModuleFontIconStyle}" Glyph="&#xF32C;"
    FontIcon Style="{StaticResource IcModuleSystemFontIconStyle}" Glyph="&#xE8C8;"

    图标字体与码位配套使用。项目 Glyphs 使用随程序部署的 Fluent System Icons。
    Windows 的 Segoe Fluent Icons / Symbol 使用系统码位。
    原生标题栏的拖动区域、系统按钮和 PreferredHeightOption 由 WindowFrame 管理。
    -->

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="IcModuleWindowBackgroundBrush" Color="{ThemeResource SolidBackgroundFillColorBase}" />
            <SolidColorBrush x:Key="IcModuleContentBackgroundBrush" Color="{ThemeResource LayerFillColorDefault}" />
            <SolidColorBrush x:Key="IcModuleCardBackgroundBrush" Color="{ThemeResource CardBackgroundFillColorDefault}" />
            <SolidColorBrush x:Key="IcModulePopupBackgroundBrush" Color="{ThemeResource SolidBackgroundFillColorBase}" />
            <SolidColorBrush x:Key="IcModuleBorderBrush" Color="{ThemeResource CardStrokeColorDefault}" />
            <SolidColorBrush x:Key="IcModuleControlBorderBrush" Color="{ThemeResource ControlStrokeColorDefault}" />
            <SolidColorBrush x:Key="IcModuleTextPrimaryBrush" Color="{ThemeResource TextFillColorPrimary}" />
            <SolidColorBrush x:Key="IcModuleTextSecondaryBrush" Color="{ThemeResource TextFillColorSecondary}" />
            <SolidColorBrush x:Key="IcModuleTextDisabledBrush" Color="{ThemeResource TextFillColorDisabled}" />
            <SolidColorBrush x:Key="IcModuleAccentBrush" Color="{ThemeResource AccentFillColorDefault}" />
            <SolidColorBrush x:Key="IcModuleOnAccentBrush" Color="{ThemeResource TextOnAccentFillColorPrimary}" />
            <SolidColorBrush x:Key="IcModuleAccentTextBrush" Color="{ThemeResource AccentTextFillColorPrimary}" />
            <SolidColorBrush x:Key="IcModuleSubtleBackgroundBrush" Color="{ThemeResource SubtleFillColorSecondary}" />
            <SolidColorBrush x:Key="IcModulePressedBackgroundBrush" Color="{ThemeResource SubtleFillColorTertiary}" />
            <SolidColorBrush x:Key="IcModuleSuccessBrush" Color="{ThemeResource SystemFillColorSuccess}" />
            <SolidColorBrush x:Key="IcModuleWarningBrush" Color="{ThemeResource SystemFillColorCaution}" />
            <SolidColorBrush x:Key="IcModuleErrorBrush" Color="{ThemeResource SystemFillColorCritical}" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="IcModuleWindowBackgroundBrush" Color="{ThemeResource SolidBackgroundFillColorBase}" />
            <SolidColorBrush x:Key="IcModuleContentBackgroundBrush" Color="{ThemeResource LayerFillColorDefault}" />
            <SolidColorBrush x:Key="IcModuleCardBackgroundBrush" Color="{ThemeResource CardBackgroundFillColorDefault}" />
            <SolidColorBrush x:Key="IcModulePopupBackgroundBrush" Color="{ThemeResource SolidBackgroundFillColorBase}" />
            <SolidColorBrush x:Key="IcModuleBorderBrush" Color="{ThemeResource CardStrokeColorDefault}" />
            <SolidColorBrush x:Key="IcModuleControlBorderBrush" Color="{ThemeResource ControlStrokeColorDefault}" />
            <SolidColorBrush x:Key="IcModuleTextPrimaryBrush" Color="{ThemeResource TextFillColorPrimary}" />
            <SolidColorBrush x:Key="IcModuleTextSecondaryBrush" Color="{ThemeResource TextFillColorSecondary}" />
            <SolidColorBrush x:Key="IcModuleTextDisabledBrush" Color="{ThemeResource TextFillColorDisabled}" />
            <SolidColorBrush x:Key="IcModuleAccentBrush" Color="{ThemeResource AccentFillColorDefault}" />
            <SolidColorBrush x:Key="IcModuleOnAccentBrush" Color="{ThemeResource TextOnAccentFillColorPrimary}" />
            <SolidColorBrush x:Key="IcModuleAccentTextBrush" Color="{ThemeResource AccentTextFillColorPrimary}" />
            <SolidColorBrush x:Key="IcModuleSubtleBackgroundBrush" Color="{ThemeResource SubtleFillColorSecondary}" />
            <SolidColorBrush x:Key="IcModulePressedBackgroundBrush" Color="{ThemeResource SubtleFillColorTertiary}" />
            <SolidColorBrush x:Key="IcModuleSuccessBrush" Color="{ThemeResource SystemFillColorSuccess}" />
            <SolidColorBrush x:Key="IcModuleWarningBrush" Color="{ThemeResource SystemFillColorCaution}" />
            <SolidColorBrush x:Key="IcModuleErrorBrush" Color="{ThemeResource SystemFillColorCritical}" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="IcModuleWindowBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="IcModuleContentBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="IcModuleCardBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="IcModulePopupBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="IcModuleBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="IcModuleControlBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="IcModuleTextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="IcModuleTextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="IcModuleTextDisabledBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="IcModuleAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="IcModuleOnAccentBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="IcModuleAccentTextBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="IcModuleSubtleBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="IcModulePressedBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="IcModuleSuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="IcModuleWarningBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="IcModuleErrorBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- 标题栏与触控尺寸 -->
    <x:Double x:Key="IcModuleTitleBarHeight">48</x:Double>
    <x:Double x:Key="IcModuleCompactTitleBarHeight">40</x:Double>
    <x:Double x:Key="IcModuleToolbarHeight">44</x:Double>
    <x:Double x:Key="IcModuleTouchTarget">44</x:Double>
    <x:Double x:Key="IcModuleCompactTouchTarget">40</x:Double>
    <x:Double x:Key="IcModuleComfortableTouchTarget">48</x:Double>
    <x:Double x:Key="IcModulePrimaryActionHeight">64</x:Double>

    <!-- 圆角用于窗口内部控件，外部窗口圆角由 Windows 管理 -->
    <CornerRadius x:Key="IcModuleControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="IcModuleCardCornerRadius">14</CornerRadius>
    <CornerRadius x:Key="IcModuleFlyoutCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="IcModulePillCornerRadius">20</CornerRadius>
    <Thickness x:Key="IcModuleBorderThickness">1</Thickness>
    <Thickness x:Key="IcModuleWindowPadding">20,8,20,20</Thickness>
    <Thickness x:Key="IcModuleCardPadding">16</Thickness>
    <Thickness x:Key="IcModuleControlPadding">10,6,10,6</Thickness>
    <Thickness x:Key="IcModuleIconButtonPadding">6</Thickness>
    <Thickness x:Key="IcModuleFlyoutPadding">16</Thickness>
    <x:Double x:Key="IcModuleSmallSpacing">8</x:Double>
    <x:Double x:Key="IcModuleContentSpacing">12</x:Double>
    <x:Double x:Key="IcModuleSectionSpacing">16</x:Double>

    <!-- 图标按字体实际外框居中，字号不参与系统文本缩放 -->
    <x:Double x:Key="IcModuleSmallIconSize">14</x:Double>
    <x:Double x:Key="IcModuleIconSize">18</x:Double>
    <x:Double x:Key="IcModuleActionIconSize">20</x:Double>
    <x:Double x:Key="IcModuleLargeIconSize">24</x:Double>
    <FontFamily x:Key="IcModuleIconFontFamily">ms-appx:///Assets/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular</FontFamily>
    <FontFamily x:Key="IcModuleSystemIconFontFamily">Segoe Fluent Icons</FontFamily>
    <x:Double x:Key="IcModuleCaptionFontSize">12</x:Double>
    <x:Double x:Key="IcModuleBodyFontSize">14</x:Double>
    <x:Double x:Key="IcModuleSubtitleFontSize">16</x:Double>

    <!-- 显式引用的样式 -->
    <Style x:Key="IcModuleTitleBarStyle" TargetType="TitleBar">
        <Setter Property="Height" Value="{StaticResource IcModuleTitleBarHeight}" />
        <Setter Property="MinHeight" Value="{StaticResource IcModuleTitleBarHeight}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource IcModuleTextPrimaryBrush}" />
    </Style>
    <Style x:Key="IcModuleCompactTitleBarStyle" TargetType="TitleBar" BasedOn="{StaticResource IcModuleTitleBarStyle}">
        <Setter Property="Height" Value="{StaticResource IcModuleCompactTitleBarHeight}" />
        <Setter Property="MinHeight" Value="{StaticResource IcModuleCompactTitleBarHeight}" />
    </Style>
    <Style x:Key="IcModuleCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource IcModuleCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource IcModuleBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource IcModuleBorderThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource IcModuleCardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource IcModuleCardPadding}" />
    </Style>
    <Style x:Key="IcModuleButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinWidth" Value="{StaticResource IcModuleTouchTarget}" />
        <Setter Property="MinHeight" Value="{StaticResource IcModuleTouchTarget}" />
        <Setter Property="Padding" Value="{StaticResource IcModuleControlPadding}" />
        <Setter Property="CornerRadius" Value="{StaticResource IcModuleControlCornerRadius}" />
        <Setter Property="FontSize" Value="{StaticResource IcModuleBodyFontSize}" />
    </Style>
    <Style x:Key="IcModulePrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinWidth" Value="{StaticResource IcModuleTouchTarget}" />
        <Setter Property="MinHeight" Value="{StaticResource IcModuleTouchTarget}" />
        <Setter Property="Padding" Value="{StaticResource IcModuleControlPadding}" />
        <Setter Property="CornerRadius" Value="{StaticResource IcModuleControlCornerRadius}" />
        <Setter Property="FontSize" Value="{StaticResource IcModuleBodyFontSize}" />
    </Style>
    <Style x:Key="IcModulePillStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="MinWidth" Value="{StaticResource IcModuleTouchTarget}" />
        <Setter Property="MinHeight" Value="{StaticResource IcModuleTouchTarget}" />
        <Setter Property="Padding" Value="{StaticResource IcModuleControlPadding}" />
        <Setter Property="CornerRadius" Value="{StaticResource IcModulePillCornerRadius}" />
    </Style>
    <Style x:Key="IcModuleIconButtonStyle" TargetType="controls:TouchIconButton">
        <Setter Property="MinWidth" Value="{StaticResource IcModuleTouchTarget}" />
        <Setter Property="MinHeight" Value="{StaticResource IcModuleTouchTarget}" />
        <Setter Property="IconSize" Value="{StaticResource IcModuleIconSize}" />
        <Setter Property="Padding" Value="{StaticResource IcModuleIconButtonPadding}" />
        <Setter Property="CornerRadius" Value="{StaticResource IcModuleControlCornerRadius}" />
    </Style>
    <Style x:Key="IcModuleCompactIconButtonStyle" TargetType="controls:TouchIconButton" BasedOn="{StaticResource IcModuleIconButtonStyle}">
        <Setter Property="Width" Value="{StaticResource IcModuleCompactTouchTarget}" />
        <Setter Property="Height" Value="{StaticResource IcModuleCompactTouchTarget}" />
        <Setter Property="MinWidth" Value="{StaticResource IcModuleCompactTouchTarget}" />
        <Setter Property="MinHeight" Value="{StaticResource IcModuleCompactTouchTarget}" />
    </Style>
    <Style x:Key="IcModuleFontIconStyle" TargetType="FontIcon">
        <Setter Property="FontFamily" Value="{StaticResource IcModuleIconFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource IcModuleIconSize}" />
        <Setter Property="IsTextScaleFactorEnabled" Value="False" />
    </Style>
    <Style x:Key="IcModuleSystemFontIconStyle" TargetType="FontIcon" BasedOn="{StaticResource IcModuleFontIconStyle}">
        <Setter Property="FontFamily" Value="{StaticResource IcModuleSystemIconFontFamily}" />
    </Style>
    <Style x:Key="IcModuleCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource IcModuleCaptionFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource IcModuleTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="IcModuleBodyStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource IcModuleBodyFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource IcModuleTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="IcModuleSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource IcModuleBodyStyle}">
        <Setter Property="FontSize" Value="{StaticResource IcModuleSubtitleFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="IcModuleFlyoutPresenterStyle" TargetType="FlyoutPresenter">
        <Setter Property="Background" Value="{ThemeResource IcModulePopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource IcModuleBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource IcModuleBorderThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource IcModuleFlyoutCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource IcModuleFlyoutPadding}" />
    </Style>
</ResourceDictionary>
